  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="random-sampling" repetitions="60" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="1000">
      <setup>setup</setup>
      <go>repeat 1000 [ go ]</go>
      <metrics>
        <metric>ticks</metric>
        <metric>sum [prey-captured] of predators</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="use-scenario?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="search-tactic">
          <value value="&quot;random-sampling&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="pen-down?">
          <value value="false"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="scenario" first="1" step="1" last="26"></steppedValueSet>
        <enumeratedValueSet variable="regeneration-time">
          <value value="1000"></value>
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="response-radius">
          <value value="9"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
